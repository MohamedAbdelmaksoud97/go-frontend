# Backend URL used only by the Next.js BFF proxy.
API_BASE_URL=http://127.0.0.1:3001

# Presence flag used to disable demo-only UI at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
# Optional override. GO Fitness production uses its built-in public tenant ID.
NEXT_PUBLIC_ORGANIZATION_ID=019c4f00-0000-7000-8000-000000000001
NEXT_PUBLIC_MEMBER_TEST_EMAIL_LOGIN=false

# Gate events and device status load on page open or manual refresh by default.
# Set to true and rebuild/redeploy to restore SSE, desktop alerts, and polling.
NEXT_PUBLIC_GATE_LIVE_UPDATES_ENABLED=false

# Authentication and session refresh are forwarded to the Node backend by the
# Next.js BFF. Do not put Supabase keys in this frontend project.
